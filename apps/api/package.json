{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=node --packages=external --outdir=dist",
    "build:lambda": "bun build src/lambda.ts --target=node --outfile=dist/lambda.js --minify --sourcemap=none",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.890.0",
    "@aws-sdk/lib-dynamodb": "^3.890.0",
    "@fastify/cors": "^11.1.0",
    "@nexora/contracts": "workspace:*",
    "fastify": "^5.12.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.5.1"
  }
}
